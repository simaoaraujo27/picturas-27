@startuml
!pragma layout smetana
left to right direction

skinparam backgroundColor #FFFFFF
skinparam shadowing false
skinparam defaultFontName DejaVu Sans
skinparam defaultFontSize 18
skinparam ActorBorderColor #334155
skinparam ArrowColor #64748B
skinparam UsecaseBorderColor #475569
skinparam UsecaseBackgroundColor #EFF6FF
skinparam nodesep 24
skinparam ranksep 30

actor "Utilizador\nautenticado" as Auth
actor "Utilizador\nFree" as Free
actor "Utilizador\nPremium" as Premium
actor "Utilizador não autenticado\n(anonymous)" as Anonymous

Free --|> Auth
Premium --|> Auth
Anonymous -[hidden]down- Free
Free -[hidden]down- Premium
Premium -[hidden]down- Auth

rectangle "PictuRAS — Fase 1: Suporte a Vídeo" #F8FAFC {
  usecase "UC-VID-001\nCarregar vídeo\npara um projeto" as Upload #DBEAFE
  usecase "UC-VID-002\nRecortar intervalo\ntemporal de vídeo" as Trim #DBEAFE
  Upload -[hidden]left- Trim
  usecase "UC-VID-003\nRemover segmento\nde vídeo" as RemoveSegment #DBEAFE
  Trim -[hidden]left- RemoveSegment
  usecase "UC-VID-004\nCompilar vídeos" as Compile #DBEAFE
  RemoveSegment -[hidden]left- Compile
  usecase "UC-VID-005\nModificar a velocidade\nde um vídeo" as Speed #DBEAFE
  Compile -[hidden]left- Speed
  usecase "Registar-se /\nIniciar sessão" as Access #F1F5F9
}

Anonymous -down- Access
Auth -down- Upload
Auth -down- Trim
Auth -down- RemoveSegment
Auth -down- Compile
Auth -down- Speed

@enduml
